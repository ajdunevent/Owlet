{
    "id": "net.dunevent.Owlet",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "owlet",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "build-args": [
            "--share=network"
        ],
        "env": {
            "CARGO_REGISTRIES_CRATES_IO_PROTOCOL": "sparse",
            "CARGO_TERM_COLOR": "always",
            "RUST_BACKTRACE": "1"
        }
    },
    "cleanup": [
        "/include",
        "/lib/pkgconfig",
        "/man",
        "/share/doc",
        "/share/gtk-doc",
        "/share/man",
        "/share/pkgconfig",
        "*.la",
        "*.a"
    ],
    "modules": [
        {
            "name": "owlet",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "dir",
                    "path": "../",
                    "skip": [
                        ".flatpak",
                        ".flatpak-builder",
                        "_build",
                        "build",
                        "build-arm64",
                        "dist",
                        "target"
                    ]
                }
            ]
        }
    ]
}
